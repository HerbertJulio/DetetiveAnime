# IA da busca por descrição, do jogo e do teste. Basta uma das duas.
# Gemini: crie em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Claude: crie em https://console.anthropic.com
ANTHROPIC_API_KEY=
# Opcional: "gemini" ou "anthropic" quando as duas estiverem preenchidas
AI_PROVIDER=

# Opcional: logos das plataformas no Brasil (TMDB, dados do JustWatch).
# Crie em https://www.themoviedb.org/settings/api  (use o "API Read Access Token")
TMDB_TOKEN=

# Opcional: aumenta a cota da busca por print no trace.moe
TRACE_MOE_KEY=

# Opcional: troca o modelo (padrão gemini-flash-latest ou claude-sonnet-5-5)
AI_MODEL=
